{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "gm_practice.py", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/gm_practice.py", "dest": "/gm_practice.py" },
    { "src": "/", "dest": "/index.html" }
  ]
}
